# Cache backend: FileSystem (default) or GCPStorage
DB_DRIVER=FileSystem

# Required when DB_DRIVER=GCPStorage
# CACHE_BUCKET=my-gcs-bucket

# Max revision batches to fetch per request (false = no limit)
MAX_BATCH_COUNT=false

# Extra CORS origins (comma-separated), e.g. for production
# CORS_ORIGINS=https://en.wikipedia.red,https://de.wikipedia.red

# Logging level: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
